---
/*
 * OrnateFrame — "Marco III", rococo mirror frame.
 *
 * 9-slice: the four corners, the crest and the bottom drop are fixed-size
 * SVGs; the gilded bands between them stretch with the content, so the
 * frame fits any width and height.
 * All ornament is decorative (aria-hidden) and colored via tokens.
 *
 * The frame fills its parent (flex-1) and reserves vertical room for the
 * crest and drop, which overflow its box. Sideways the corners overflow
 * ~14px: keep at least that much gutter around it (page padding / gap).
 */

// Unique ids per instance: several frames share a page.
let count = (globalThis as any).__ornateFrameCount ?? 0;
(globalThis as any).__ornateFrameCount = ++count;
const id = `of${count}`;
---

<div class='ornate-frame'>
  <div class='frame'>
    <div class='paper' aria-hidden='true'></div>
    <div class='band band-t' aria-hidden='true'></div>
    <div class='band band-b' aria-hidden='true'></div>
    <div class='band band-l' aria-hidden='true'></div>
    <div class='band band-r' aria-hidden='true'></div>

    <svg viewBox='-22 -30 162 170' class='corner tl' aria-hidden='true'>
      <defs>
        <linearGradient id={`${id}-gold`} x1='0' y1='0' x2='1' y2='1'>
          <stop offset='0' style='stop-color: var(--ornament-light)'></stop>
          <stop offset='0.45' style='stop-color: var(--ornament)'></stop>
          <stop offset='0.7' style='stop-color: var(--ornament-deep)'></stop>
          <stop offset='1' style='stop-color: var(--ornament-soft)'></stop>
        </linearGradient>
        <pattern id={`${id}-hatch`} width='4' height='4' patternUnits='userSpaceOnUse' patternTransform='rotate(45)'>
          <line x1='0' y1='0' x2='0' y2='4' class='ink' stroke-width='0.7' opacity='0.55'></line>
        </pattern>
        <g id={`${id}-corner`} class='ink' stroke-linecap='round' stroke-linejoin='round'>
          <path d='M140,20 L60,20 A40,40 0 0 1 20,60 L20,140 L36,140 L36,74 A56,56 0 0 0 74,36 L140,36 Z' fill={`url(#${id}-gold)`} stroke='none'></path>
          <path d='M140,20 L60,20 A40,40 0 0 1 20,60 L20,140 L36,140 L36,74 A56,56 0 0 0 74,36 L140,36 Z' fill={`url(#${id}-hatch)`} stroke='none'></path>
          <path d='M140,20 L60,20 A40,40 0 0 1 20,60 L20,140' fill='none' stroke-width='1' vector-effect='non-scaling-stroke'></path>
          <path d='M140,36 L74,36 A56,56 0 0 1 36,74 L36,140' fill='none' stroke-width='1' vector-effect='non-scaling-stroke'></path>
          <path d='M62,22 C80,10 100,8 118,14 C128,18 128,30 120,30 C114,30 114,24 118,23' fill='none' stroke-width='1.3'></path>
          <path d='M22,62 C10,80 8,100 14,118 C18,128 30,128 30,120 C30,114 24,114 23,118' fill='none' stroke-width='1.3'></path>
          <path d='M42,42 C58,50 66,62 66,78 C60,70 52,66 44,68 C50,58 48,50 42,42 Z' fill={`url(#${id}-gold)`} stroke-width='1'></path>
          <path d='M42,42 C50,58 62,66 78,66 C70,60 66,52 68,44 C58,50 50,48 42,42 Z' fill={`url(#${id}-gold)`} stroke-width='1'></path>
          <path d='M62,22 C56,2 34,-10 14,-6 C-2,-2 -8,14 -6,30 C-6,44 4,58 22,62 C34,50 50,34 62,22 Z' fill={`url(#${id}-gold)`} stroke-width='1.2'></path>
          <path d='M42,42 L14,-6 C-2,-2 -8,14 -6,30 C-6,44 4,58 22,62 Z' fill={`url(#${id}-hatch)`} stroke='none'></path>
          <path d='M50,4 C46,-4 36,-6 32,0 C30,-8 18,-10 14,-2 C8,-8 -4,-2 0,8 C-8,10 -8,22 0,26 C-6,32 -4,44 4,48' fill='none' stroke-width='0.9'></path>
          <path d='M42,42 L50,4 M42,42 L32,0 M42,42 L14,-2 M42,42 L0,8 M42,42 L0,26 M42,42 L4,48' fill='none' stroke-width='0.8'></path>
          <path d='M-4,4 C-14,0 -22,-8 -16,-16 C-10,-22 -2,-16 -6,-12' fill='none' stroke-width='1.2'></path>
          <path d='M88,14 L92,20 M94,12 L98,18 M14,88 L20,92 M12,94 L18,98' fill='none' stroke-width='0.7'></path>
        </g>
      </defs>
      <use href={`#${id}-corner`}></use>
    </svg>
    <svg viewBox='-22 -30 162 170' class='corner tr' aria-hidden='true'><use href={`#${id}-corner`}></use></svg>
    <svg viewBox='-22 -30 162 170' class='corner bl' aria-hidden='true'><use href={`#${id}-corner`}></use></svg>
    <svg viewBox='-22 -30 162 170' class='corner br' aria-hidden='true'><use href={`#${id}-corner`}></use></svg>

    <!-- Crest: shell over an empty cartouche (no monogram) -->
    <svg viewBox='-110 -40 220 90' class='crest' aria-hidden='true'>
      <g class='ink' stroke-linecap='round' stroke-linejoin='round'>
        <path d='M-70,37 L-70,36 C-48,36 -40,16 -20,10 C-8,6 8,6 20,10 C40,16 48,36 70,36 L70,37 Z' class='fill-card' stroke='none'></path>
        <path d='M-70,20 C-45,20 -38,-2 -20,-8 C-8,-12 8,-12 20,-8 C38,-2 45,20 70,20 L70,36 C48,36 40,16 20,10 C8,6 -8,6 -20,10 C-40,16 -48,36 -70,36 Z' fill={`url(#${id}-gold)`} stroke='none'></path>
        <path d='M-70,20 C-45,20 -38,-2 -20,-8 C-8,-12 8,-12 20,-8 C38,-2 45,20 70,20 L70,36 C48,36 40,16 20,10 C8,6 -8,6 -20,10 C-40,16 -48,36 -70,36 Z' fill={`url(#${id}-hatch)`} stroke='none'></path>
        <path d='M-70,20 C-45,20 -38,-2 -20,-8 C-8,-12 8,-12 20,-8 C38,-2 45,20 70,20' fill='none' stroke-width='1' vector-effect='non-scaling-stroke'></path>
        <path d='M-70,36 C-48,36 -40,16 -20,10 C-8,6 8,6 20,10 C40,16 48,36 70,36' fill='none' stroke-width='1' vector-effect='non-scaling-stroke'></path>
        <path d='M-40,6 C-54,-4 -70,-2 -74,8 C-78,18 -66,24 -60,18' fill='none' stroke-width='1.3'></path>
        <path d='M40,6 C54,-4 70,-2 74,8 C78,18 66,24 60,18' fill='none' stroke-width='1.3'></path>
        <path d='M-16,-14 C-14,-26 -6,-32 0,-32 C6,-32 14,-26 16,-14 Z' fill={`url(#${id}-gold)`} stroke-width='1'></path>
        <path d='M0,-14 L-8,-26 M0,-14 L0,-31 M0,-14 L8,-26' fill='none' stroke-width='0.7'></path>
        <ellipse cx='0' cy='6' rx='42' ry='26' class='fill-muted' stroke-width='1.3'></ellipse>
        <ellipse cx='0' cy='6' rx='34' ry='19' fill='none' class='beads-stroke' stroke-width='2.2' stroke-dasharray='0 6'></ellipse>
      </g>
    </svg>

    <!-- Bottom drop -->
    <svg viewBox='-110 -50 220 90' class='drop' aria-hidden='true'>
      <g class='ink' stroke-linecap='round' stroke-linejoin='round'>
        <path d='M-70,-37 L70,-37 L70,-36 C48,-36 40,-20 20,-14 C8,-11 -8,-11 -20,-14 C-40,-20 -48,-36 -70,-36 Z' class='fill-card' stroke='none'></path>
        <path d='M-70,-36 C-48,-36 -40,-20 -20,-14 C-8,-11 8,-11 20,-14 C40,-20 48,-36 70,-36 L70,-20 C48,-20 40,-4 20,2 C8,5 -8,5 -20,2 C-40,-4 -48,-20 -70,-20 Z' fill={`url(#${id}-gold)`} stroke='none'></path>
        <path d='M-70,-36 C-48,-36 -40,-20 -20,-14 C-8,-11 8,-11 20,-14 C40,-20 48,-36 70,-36 L70,-20 C48,-20 40,-4 20,2 C8,5 -8,5 -20,2 C-40,-4 -48,-20 -70,-20 Z' fill={`url(#${id}-hatch)`} stroke='none'></path>
        <path d='M-70,-36 C-48,-36 -40,-20 -20,-14 C-8,-11 8,-11 20,-14 C40,-20 48,-36 70,-36' fill='none' stroke-width='1' vector-effect='non-scaling-stroke'></path>
        <path d='M-70,-20 C-48,-20 -40,-4 -20,2 C-8,5 8,5 20,2 C40,-4 48,-20 70,-20' fill='none' stroke-width='1' vector-effect='non-scaling-stroke'></path>
        <path d='M-22,2 C-20,18 -10,30 0,30 C10,30 20,18 22,2 Z' fill={`url(#${id}-gold)`} stroke-width='1.1'></path>
        <path d='M0,4 L-14,18 M0,4 L0,28 M0,4 L14,18' fill='none' stroke-width='0.7'></path>
      </g>
    </svg>

    <div class='content'>
      <slot />
    </div>
  </div>
</div>

<style>
  .ornate-frame {
    /* Scale of the ornament (the style tile's grid / mobile card). */
    --s: 0.62;
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    /* Room for the crest and drop, which overflow the frame box */
    padding-block: calc(26px * var(--s) + 4px);
  }

  .frame {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    /* The gilded frame is the only border: content sits on the ivory,
       just clear of the corner shells (~48px deep) top and bottom and
       ~18px inside the side bands. */
    padding:
      calc(72px * var(--s) + 8px)
      calc(36px * var(--s) + 18px)
      calc(72px * var(--s) + 4px);
    filter: drop-shadow(0 12px 14px color-mix(in srgb, var(--ornament-line) 18%, transparent));
  }

  .content {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* Ivory paper with the corners scooped out behind the corner ornaments */
  .paper {
    --r: calc(56px * var(--s));
    --o: calc(16px * var(--s));
    position: absolute;
    inset: calc(36px * var(--s));
    background:
      radial-gradient(circle var(--r) at calc(var(--o) * -1) calc(var(--o) * -1), transparent var(--r), var(--card) calc(var(--r) + 0.6px)) left top / 51% 51% no-repeat,
      radial-gradient(circle var(--r) at calc(100% + var(--o)) calc(var(--o) * -1), transparent var(--r), var(--card) calc(var(--r) + 0.6px)) right top / 51% 51% no-repeat,
      radial-gradient(circle var(--r) at calc(var(--o) * -1) calc(100% + var(--o)), transparent var(--r), var(--card) calc(var(--r) + 0.6px)) left bottom / 51% 51% no-repeat,
      radial-gradient(circle var(--r) at calc(100% + var(--o)) calc(100% + var(--o)), transparent var(--r), var(--card) calc(var(--r) + 0.6px)) right bottom / 51% 51% no-repeat;
  }

  /* Gilded, hatched bands that stretch between the corners */
  .band {
    position: absolute;
    background:
      repeating-linear-gradient(45deg, color-mix(in srgb, var(--ornament-line) 38%, transparent) 0 0.7px, transparent 0.7px 3px),
      linear-gradient(135deg, var(--ornament-light), var(--ornament) 45%, var(--ornament-deep) 70%, var(--ornament-soft));
  }
  .band-t,
  .band-b {
    left: calc(140px * var(--s));
    right: calc(140px * var(--s));
    height: calc(16px * var(--s));
    border-block: 1px solid var(--ornament-line);
  }
  .band-t { top: calc(20px * var(--s)); }
  .band-b { bottom: calc(20px * var(--s)); }
  .band-l,
  .band-r {
    top: calc(140px * var(--s));
    bottom: calc(140px * var(--s));
    width: calc(16px * var(--s));
    border-inline: 1px solid var(--ornament-line);
  }
  .band-l { left: calc(20px * var(--s)); }
  .band-r { right: calc(20px * var(--s)); }

  /* Fixed-size ornaments */
  /* The viewBox starts at the leftmost stroke (x = -22), so the box doesn't
     stick out further than the drawing (no stray horizontal scroll). */
  .corner {
    position: absolute;
    width: calc(162px * var(--s));
    height: calc(170px * var(--s));
    overflow: visible;
  }
  .tl { left: calc(-22px * var(--s)); top: calc(-30px * var(--s)); }
  .tr { right: calc(-22px * var(--s)); top: calc(-30px * var(--s)); transform: scaleX(-1); }
  .bl { left: calc(-22px * var(--s)); bottom: calc(-30px * var(--s)); transform: scaleY(-1); }
  .br { right: calc(-22px * var(--s)); bottom: calc(-30px * var(--s)); transform: scale(-1, -1); }

  .crest,
  .drop {
    position: absolute;
    left: calc(50% - 110px * var(--s));
    width: calc(220px * var(--s));
    height: calc(90px * var(--s));
    overflow: visible;
  }
  .crest { top: calc(-40px * var(--s)); }
  .drop { bottom: calc(-40px * var(--s)); }

  .ink { stroke: var(--ornament-line); }
  .fill-card { fill: var(--card); }
  .fill-muted { fill: var(--muted); }
  .beads-stroke { stroke: var(--ornament-shadow); }
</style>
