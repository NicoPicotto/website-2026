---
import OrnateFrame from './ornament/OrnateFrame.astro';

interface Props {
  title: string;
  summary: string;
  client?: string;
  year: number;
  tags: string[];
  href: string;
  cover?: string;
  liveUrl?: string;
}

const { title, summary, client, year, tags, href, cover } = Astro.props;
---

<a href={href} class="group flex-1 flex">
  <OrnateFrame>
    <!-- Cover -->
    {cover ? (
      <img src={cover} alt={title} class="card-img w-full aspect-video object-cover border border-(--border)" />
    ) : (
      <div class="w-full aspect-video bg-(--muted) border border-(--border) flex items-center justify-center">
        <span class="font-heading text-4xl font-bold text-(--subtle-foreground) select-none">
          {title.charAt(0)}
        </span>
      </div>
    )}

    <!-- Content -->
    <div class="flex flex-col flex-1 pt-5 gap-4">
      <!-- Tags -->
      {tags.length > 0 && (
        <ul class="flex flex-wrap gap-2">
          {tags.slice(0, 3).map((tag) => (
            <li class="tag">
              {tag}
            </li>
          ))}
        </ul>
      )}

      <!-- Title & summary -->
      <div class="flex flex-col gap-2 flex-1">
        <h3 class="text-base leading-snug group-hover:text-(--primary) transition-colors">
          {title}
        </h3>
        <p class="text-sm text-(--foreground) line-clamp-2">{summary}</p>
      </div>

      <!-- Client & year -->
      <p class="text-xs text-(--muted-foreground) mt-auto">
        {client && <span>{client} · </span>}{year}
      </p>
    </div>
  </OrnateFrame>
</a>
