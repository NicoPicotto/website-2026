---
import Layout from '../layouts/Layout.astro';
import Divider from '../components/ornament/Divider.astro';
---

<Layout title="Page not found" description="The page you were looking for could not be found.">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-28 text-center">
    <p class="kicker mb-3">Error 404</p>
    <h1 class="text-4xl sm:text-6xl leading-[1.05]">
      This page has been <span class="block italic font-bold text-(--primary)">lost to the ages</span>
    </h1>
    <p class="mt-6 text-xl text-(--foreground) max-w-xl mx-auto">
      The page you sought has wandered off, or perhaps never was. Allow me to
      escort you back to more familiar halls.
    </p>
    <div class="my-10">
      <Divider />
    </div>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/" class="btn-primary">Return to the home page</a>
      <a href="/case-studies/" class="btn-secondary">View the works</a>
    </div>
  </section>
</Layout>
