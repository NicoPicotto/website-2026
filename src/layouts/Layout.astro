---
import '../styles/globals.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import IntroCurtain from '../components/IntroCurtain.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'case-study';
  publishDate?: Date;
  updatedDate?: Date;
}

const {
  title,
  description = 'Nicolas Picotto — Fullstack Developer & Designer',
  image = '/og-image.png',
  type = 'website',
  publishDate,
  updatedDate,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://nicopicotto.dev';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = image.startsWith('http') ? image : new URL(image, siteUrl).toString();
const fullTitle = title === 'Nicolas Picotto' ? title : `${title} | Nicolas Picotto`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nicolas Picotto',
  url: siteUrl,
  sameAs: ['https://www.linkedin.com/in/nicolaspicotto/', 'https://x.com/NicoPicotto'],
  jobTitle: 'Fullstack Developer & Designer',
  image: `${siteUrl}/hero-image.png`,
  email: 'hola@nicopicotto.dev',
  description:
    'Fullstack Developer & Designer specialising in the bridge between UX design and frontend/backend development. Building digital products for startups and growth-stage companies.',
  knowsAbout: [
    'Frontend Development',
    'Backend Development',
    'UX Design',
    'Product Design',
    'Scroll Animations',
    'Webflow',
    'React',
    'Tailwind CSS',
    'Astro',
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: ogImage,
  url: canonicalUrl,
  datePublished: publishDate?.toISOString(),
  dateModified: (updatedDate ?? publishDate)?.toISOString(),
  author: { '@type': 'Person', name: 'Nicolas Picotto', url: siteUrl },
  publisher: { '@type': 'Person', name: 'Nicolas Picotto', url: siteUrl },
};

const creativeWorkSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  image: ogImage,
  url: canonicalUrl,
  creator: { '@type': 'Person', name: 'Nicolas Picotto', url: siteUrl },
};

// Opera-curtain intro, home only. Shown when the home is entered from
// outside the site (first visit, external link, typed URL) and on every
// reload; skipped when arriving from another page of the site or via
// back/forward. Decided before first paint so it never flashes, and
// skipped without JS or with reduced motion. The 9s timeout is a failsafe
// in case the intro script never runs (its own safety timeout is 6s).
const isHome = Astro.url.pathname === '/';
const introGate = `(function(){try{var d=document.documentElement;if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;var n=performance.getEntriesByType&&performance.getEntriesByType('navigation')[0];var t=n?n.type:'navigate';if(t==='back_forward')return;if(t!=='reload'&&document.referrer&&new URL(document.referrer).origin===location.origin)return;d.classList.add('intro-on');setTimeout(function(){d.classList.remove('intro-on','intro-opening')},9000)}catch(e){}})();`;

const jsonLd =
  type === 'website' ? personSchema : type === 'article' ? articleSchema : creativeWorkSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Nicolas Picotto" />
    <meta property="og:locale" content="en_US" />
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@NicoPicotto" />
    <meta name="twitter:creator" content="@NicoPicotto" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {isHome && <script is:inline set:html={introGate} />}
  </head>
  <body class="min-h-screen">
    {isHome && <IntroCurtain />}
    <Header />
    <main class="relative z-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
